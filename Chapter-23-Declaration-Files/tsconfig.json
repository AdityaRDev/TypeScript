{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "allowJs": true,
        "skipLibCheck": true
    },
    "include": [
        "*.ts",
        "*.js",
        "*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}